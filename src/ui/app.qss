* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei";
}
QMainWindow, QDialog {
    background-color: #e9edf2;
}
QWidget {
    color: #1e2733;
    font-size: 10.5pt;
}
QToolTip {
    color: #1e2733;
    background-color: #ffffff;
    border: 1px solid #c5cdd6;
    padding: 4px;
}

/* ================= 底部状态条 ================= */
QFrame#statusStrip {
    background-color: #ffffff;
    border: none;
    border-top: 1px solid #d9dfe6;
}
QFrame#statusStrip QLabel {
    background-color: transparent;
    font-size: 9.5pt;
}
QFrame[chip="true"] {
    background-color: transparent;
    border: none;
}
QFrame[chip="true"] QLabel {
    background-color: transparent;
}
QLabel[role="chipTitle"] {
    color: #7b8794;
    font-size: 9.5pt;
}
QLabel[role="chipValue"] {
    font-weight: bold;
    color: #95a0ac;
}
QLabel[state="ok"]    { color: #16a34a; }
QLabel[state="busy"]  { color: #2563eb; }
QLabel[state="warn"]  { color: #d97706; }
QLabel[state="off"]   { color: #95a0ac; }
QLabel[state="error"] { color: #dc2626; }

/* ================= 导航栏 ================= */
QFrame#navRail {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #d9dfe6;
}
QListWidget#navList {
    background-color: transparent;
    border: none;
    outline: 0;
}
QListWidget#navList::item {
    color: #52606d;
    border-radius: 6px;
    margin: 4px 0px;
    padding: 8px 0px 6px 0px;
}
QListWidget#navList::item:hover {
    background-color: #f2f6fd;
    color: #1d4ed8;
}
QListWidget#navList::item:selected {
    background-color: #e8effd;
    color: #1d4ed8;
    font-weight: bold;
}
QLabel#versionLabel {
    color: #a3adb8;
    font-size: 8.5pt;
    background-color: transparent;
}

/* ================= 卡片 ================= */
QFrame[card="true"] {
    background-color: #ffffff;
    border: 1px solid #d9dfe6;
    border-radius: 6px;
}
QFrame[card="true"] > QLabel, QFrame[metric="true"] > QLabel {
    background-color: transparent;
}
QLabel[role="cardTitle"] {
    font-size: 11.5pt;
    font-weight: bold;
}
QLabel[role="hint"] {
    color: #7b8794;
    font-size: 9pt;
}
QFrame[metric="true"] {
    background-color: #f4f6f9;
    border: 1px solid #e1e6ec;
    border-left: 3px solid #2563eb;
    border-radius: 4px;
}
QLabel[role="metricTitle"] {
    color: #66737f;
    font-size: 9.5pt;
}
QLabel[role="metricValue"] {
    color: #1e2733;
    font-size: 20pt;
    font-weight: bold;
}
QFrame#toolSeparator {
    background-color: #d9dfe6;
    border: none;
}
QLabel#PicLabel {
    background-color: #f4f6f9;
    border: 1px dashed #c5cdd6;
    border-radius: 4px;
    color: #8a94a0;
    font-size: 11pt;
}

/* ================= 侧面板 / 分组 ================= */
QStackedWidget#pageStack, QStackedWidget#pageStack > QWidget,
QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d9dfe6;
    border-radius: 6px;
    margin-top: 26px;
    padding: 10px 12px 12px 12px;
    font-size: 11pt;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    padding: 0px 2px 6px 2px;
    color: #1e2733;
    background-color: transparent;
}
QGroupBox QLabel, QGroupBox QCheckBox, QGroupBox QLineEdit, QGroupBox QComboBox,
QGroupBox QPushButton, QGroupBox QToolButton, QGroupBox QListWidget {
    font-size: 10.5pt;
    font-weight: normal;
}
QGroupBox QLabel[role="hint"] {
    font-size: 9pt;
}

/* ================= 按钮 ================= */
QPushButton, QToolButton {
    background-color: #ffffff;
    color: #1e2733;
    border: 1px solid #c5cdd6;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 22px;
}
QPushButton:hover, QToolButton:hover {
    background-color: #f2f6fd;
    border-color: #2563eb;
    color: #1d4ed8;
}
QPushButton:pressed, QToolButton:pressed {
    background-color: #e1eafb;
}
QPushButton:disabled, QToolButton:disabled {
    background-color: #f1f3f6;
    color: #a3adb8;
    border-color: #e0e5ea;
}
QPushButton[primary="true"] {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
    font-weight: bold;
}
QPushButton[primary="true"]:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
}
QPushButton[primary="true"]:pressed {
    background-color: #1e40af;
}
QPushButton[primary="true"]:disabled {
    background-color: #b9cbf4;
    border-color: #b9cbf4;
    color: #f3f6fd;
}
QPushButton[danger="true"] {
    color: #c62828;
    border-color: #e5b5b5;
}
QPushButton[danger="true"]:hover {
    background-color: #fdf1f1;
    border-color: #c62828;
    color: #c62828;
}
QPushButton[danger="true"]:disabled {
    color: #a3adb8;
    border-color: #e0e5ea;
    background-color: #f1f3f6;
}

/* ================= 输入 ================= */
QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #c5cdd6;
    border-radius: 4px;
    padding: 5px 8px;
    min-height: 22px;
    selection-background-color: #2563eb;
}
QLineEdit:focus, QComboBox:focus, QComboBox:on {
    border-color: #2563eb;
}
QLineEdit:disabled, QComboBox:disabled {
    background-color: #f1f3f6;
    color: #95a0ac;
    border-color: #e0e5ea;
}
QLineEdit[readOnlyLook="true"] {
    background-color: #f4f6f9;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
}
QComboBox::down-arrow {
    image: url(:/ui/arrow_down.png);
    width: 12px;
    height: 8px;
}
QComboBox::down-arrow:disabled {
    image: url(:/ui/arrow_down_disabled.png);
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c5cdd6;
    outline: 0;
    selection-background-color: #e1eafb;
    selection-color: #1d4ed8;
    padding: 2px;
}

/* ================= 复选框 ================= */
QCheckBox {
    spacing: 8px;
    background-color: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b3bdc8;
    border-radius: 3px;
    background-color: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #2563eb;
}
QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
    image: url(:/ui/check.png);
}
QCheckBox::indicator:disabled {
    background-color: #eceff3;
    border-color: #d6dce3;
}
QCheckBox:disabled {
    color: #a3adb8;
}

/* ================= 列表 ================= */
QListWidget#DefectListWidget {
    background-color: #ffffff;
    border: 1px solid #d9dfe6;
    border-radius: 4px;
    padding: 4px;
    outline: 0;
}
QListWidget#DefectListWidget::item {
    padding: 6px 6px;
    border-bottom: 1px solid #eef1f4;
}
QListWidget#DefectListWidget::item:selected {
    background-color: #e1eafb;
    color: #1d4ed8;
}

/* ================= 滚动条 ================= */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #c3cbd4;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #a3adb8;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #c3cbd4;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ================= 登录 ================= */
QFrame#brandPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f3f7fe, stop:1 #e1eafb);
    border: none;
    border-right: 1px solid #d5dff0;
}
QFrame#brandPanel QLabel {
    background-color: transparent;
    color: #1e2733;
}
QLabel#brandTitle {
    font-size: 16pt;
    font-weight: bold;
}
QLabel#brandTagline {
    color: #52606d;
    font-size: 10pt;
}
QLabel#brandFooter {
    color: #7b8794;
    font-size: 9pt;
}
QFrame#formPanel {
    background-color: #ffffff;
    border: none;
}
QLabel#LoginTitle {
    font-size: 18pt;
    font-weight: bold;
    color: #1e2733;
}
QLabel#loginHint {
    color: #7b8794;
    font-size: 9.5pt;
}
QFrame#formPanel QLineEdit, QFrame#formPanel QComboBox {
    min-height: 28px;
    font-size: 11pt;
}
QPushButton#LoginBtn {
    min-height: 32px;
    font-size: 12pt;
}